    {"name":"ampersand-equals","query":[["SearchTerm","a&b=c"],["x=y","1"]],"expected":"SearchTerm=a%26b%3Dc&x%3Dy=1"},
    {"name":"percent","query":[["SearchTerm","100% %41 %zz"]],"expected":"SearchTerm=100%25+%2541+%25zz"},
    {"name":"non-ascii","query":[["SearchTerm","Amélie Café ÆØÅ"],["Ünï","日本語"]],"expected":"SearchTerm=Am%C3%A9lie+Caf%C3%A9+%C3%86%C3%98%C3%85&%C3%9Cn%C3%AF=%E6%97%A5%E6%9C%AC%E8%AA%9E"},
    {"name":"astral","query":[["SearchTerm","🎬 film 𝄞"]],"expected":"SearchTerm=%F0%9F%8E%AC+film+%F0%9D%84%9E"},
    {"name":"slash-question-hash","query":[["ParentId","a/b?c#d"]],"expected":"ParentId=a%2Fb%3Fc%23d"},
