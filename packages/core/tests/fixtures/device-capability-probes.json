{
  "description": "T8-07 shared vectors (docs/specs/T8-07.md, Test plan 1). `platform` is what the Android half reads from the device, with each reported profile already named by PlatformNames (`name`, and `bitDepth` for AV1 and VP9); `capabilities` is the PlayerCapabilities the probe answers for it; `plays` is what the core's devicePlayability answers for the video of each source against that answer. Kotlin: CapabilityMapTest (order of videoDecoders not pinned). TypeScript: packages/core/src/domain/device-capability-probes.test.ts. A decoder of h264, hevc, av1, vp9, mpeg2video or mpeg4 that reports an empty profile list is deliberately not a vector here (spec check issue 1: the implementer settles it against Media3 1.11.1).",
  "cases": [
    {
      "name": "an AVC hardware decoder reporting only High lists High, Main and Constrained Baseline",
      "platform": {
        "video": [{ "codec": "h264", "hardware": true, "profiles": [{ "name": "High" }] }],
        "audio": ["aac"],
        "hdr": [],
        "passthrough": []
      },
      "capabilities": {
        "probe": "complete",
        "videoDecoders": [
          { "codec": "h264", "hardware": true, "profile": "High" },
          { "codec": "h264", "hardware": true, "profile": "Main" },
          { "codec": "h264", "hardware": true, "profile": "Constrained Baseline" }
        ],
        "audioDecoders": ["aac"],
        "hdr": [],
        "passthrough": []
      },
      "plays": [
        { "source": { "video": { "codec": "h264", "profile": "Main", "bitDepth": 8, "width": 1920, "height": 1080 } }, "video": true },
        { "source": { "video": { "codec": "h264", "profile": "High", "bitDepth": 8, "width": 1920, "height": 1080 } }, "video": true },
        { "source": { "video": { "codec": "h264", "profile": "Constrained Baseline", "bitDepth": 8, "width": 640, "height": 360 } }, "video": true },
        { "source": { "video": { "codec": "h264", "profile": "Baseline", "bitDepth": 8, "width": 640, "height": 360 } }, "video": false },
        { "source": { "video": { "codec": "h264", "profile": "High 10", "bitDepth": 10, "width": 1920, "height": 1080 } }, "video": false },
        { "source": { "video": { "codec": "h264", "bitDepth": 8, "width": 1920, "height": 1080 } }, "video": false }
      ]
    },
    {
      "name": "two AVC decoders reporting the same profile give each entry once",
      "platform": {
        "video": [
          { "codec": "h264", "hardware": true, "profiles": [{ "name": "Main" }] },
          { "codec": "h264", "hardware": true, "profiles": [{ "name": "Main" }, { "name": "Constrained Baseline" }] }
        ],
        "audio": ["aac"],
        "hdr": [],
        "passthrough": []
