{
  "name": "octave",
  "private": true,
  "version": "0.1.0",
  "description": "A Jellyfin and Jellyscale client for the TV that plays the original file whenever the device can.",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "test": "pnpm --filter @octave/core --fail-if-no-match test && vitest run",
    "test:watch": "vitest",
    "task": "node scripts/task.mjs",
    "test:workflow": "node --test .claude/workflows/*.test.mjs",
    "test:tripwire": "tsx tests/integration/tripwire.ts",
    "fixture:up": "bash tests/integration/fixture-up.sh",
    "fixture:setup": "bash tests/integration/setup-servers.sh",
    "fixture:check-jellyscale": "tsx tests/integration/record-jellyscale-fixtures.ts --check",
    "fixture:down": "bash tests/integration/fixture-down.sh",
    "samples:generate": "bash scripts/generate-samples.sh",
    "tv:prebuild": "node scripts/tv-prebuild.mjs",
    "tv:build": "node scripts/tv-build.mjs",
    "tv:e2e:build": "node scripts/tv-build.mjs --e2e",
    "tv:native:test": "node scripts/tv-native-test.mjs",
    "tv:apk:check": "node scripts/tv-apk-check.mjs && node scripts/tv-apk-manifest.mjs && node scripts/tv-apk-inspector.mjs",
    "tv:smoke": "node scripts/tv-first-focus.mjs",
    "tv:e2e": "node scripts/tv-e2e.mjs",
    "tv:wire": "node scripts/tv-wire.mjs",
    "lint": "node --import ./scripts/typescript-6-resolve.mjs node_modules/eslint/bin/eslint.js --max-warnings 0 packages/core/src apps/tv modules",
    "lint:boundaries": "node scripts/lint-boundaries.mjs",
    "lint:backlog": "node scripts/check-backlog.mjs",
    "lint:ghost-terms": "node scripts/check-ghost-terms.mjs",
    "lint:network": "node scripts/check-network-paths.mjs",
    "lint:logs": "node scripts/check-session-logs.mjs",
    "lint:flow": "node scripts/check-flow.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/core/tsconfig.json && tsc -p apps/tv/tsconfig.json",
    "check": "pnpm lint:boundaries && pnpm lint && pnpm lint:network && pnpm lint:logs && pnpm lint:ghost-terms && pnpm lint:flow && pnpm test && pnpm typecheck && pnpm test:workflow"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "8.73.0",
    "dependency-cruiser": "18.8.0",
    "eslint": "10.15.0",
    "tsx": "4.23.15",
    "typescript": "~7.0.2",
    "typescript-6": "npm:typescript@6.0.3",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=26"
  }
}
